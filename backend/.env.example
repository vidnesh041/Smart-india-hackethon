# ==========================================================
# RURAL ADVISORY & FINANCIAL STRUCTURING ASSISTANT - ENV CONFIG
# ==========================================================

# 1. Database Configuration
# Default is local SQLite. For production PostgreSQL, specify your connection URL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/rural_advisory_db
DATABASE_URL=sqlite:///./rural_advisory.db

# 2. Google Gemini API Key
# Put your Gemini API Key here (from Google AI Studio):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. Optional OpenAI Key (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
